# Copy to .env and adjust as needed. docker-compose.yml overrides some values for container networking.

# --- go-gateway ---

# Go gateway HTTP listen address
HTTP_ADDR=:8080

# pprof listen address (only used when PPROF_ENABLED=true).
# localhost-only by default; set :6060 explicitly to expose beyond the host/pod.
PPROF_ADDR=localhost:6060

# Enable Go runtime profiling endpoint (default: off)
PPROF_ENABLED=false

# Python gRPC backend address
AI_SERVICE_ADDR=localhost:50051

# OTLP endpoint for tracing export
JAEGER_ENDPOINT=localhost:4317

# Log level for both go-gateway (slog) and python-ai (logging): DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=info

# HTTP server timeouts. HTTP_WRITE_TIMEOUT must exceed MODEL_TIMEOUT or long
# generations / SSE streams get cut off; the gateway auto-raises it if too low.
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=75s
HTTP_IDLE_TIMEOUT=60s

# Graceful shutdown grace period for in-flight requests (should cover
# MODEL_TIMEOUT; keep below the pod's terminationGracePeriodSeconds)
SHUTDOWN_TIMEOUT=75s

# gRPC client keepalive and message size. GRPC_KEEP_ALIVE_TIME must stay above
# python-ai's min ping interval (20s) or the server rejects pings with GOAWAY.
GRPC_KEEP_ALIVE_TIME=30s
GRPC_KEEP_ALIVE_TIMEOUT=3s
GRPC_MAX_RECV_MSG_SIZE=52428800

# Per-endpoint upstream timeouts
IRIS_TIMEOUT=3s
MODEL_TIMEOUT=60s

# Maximum prompt length accepted by /predict/model endpoints
MAX_PROMPT_LEN=2000

# --- python-ai ---

# Ollama API base URL
OLLAMA_HOST=http://localhost:11434

# Ollama model to serve
MODEL_NAME=qwen2.5:1.5b

# Ollama HTTP call timeout in seconds (keep slightly below MODEL_TIMEOUT so
# worker threads are released when the gateway has already given up)
OLLAMA_TIMEOUT_SEC=55

# Optional path to a pre-trained Iris model (unset = built-in default)
# IRIS_MODEL_PATH=
