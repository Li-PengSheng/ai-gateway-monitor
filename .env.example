# Copy to .env and adjust as needed. docker-compose.yml overrides some values for container networking.

# --- go-gateway ---

# Go gateway HTTP listen address
HTTP_ADDR=:8080

# pprof listen address (only used when PPROF_ENABLED=true)
PPROF_ADDR=:6060

# Enable Go runtime profiling endpoint (default: off)
PPROF_ENABLED=false

# Python gRPC backend address
AI_SERVICE_ADDR=localhost:50051

# OTLP endpoint for tracing export
JAEGER_ENDPOINT=localhost:4317

# Log level for both go-gateway (slog) and python-ai (logging): DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=info

# HTTP server timeouts
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s

# gRPC client keepalive and message size
GRPC_KEEP_ALIVE_TIME=10s
GRPC_KEEP_ALIVE_TIMEOUT=3s
GRPC_MAX_RECV_MSG_SIZE=52428800

# Per-endpoint upstream timeouts
IRIS_TIMEOUT=3s
MODEL_TIMEOUT=60s

# Maximum prompt length accepted by /predict/model endpoints
MAX_PROMPT_LEN=2000

# --- python-ai ---

# Ollama API base URL
OLLAMA_HOST=http://localhost:11434

# Ollama model to serve
MODEL_NAME=qwen2.5:1.5b

# Optional path to a pre-trained Iris model (unset = built-in default)
# IRIS_MODEL_PATH=
